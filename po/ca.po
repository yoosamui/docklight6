msgid "Show application names when the pointer rests on dock icons."
msgstr "Mostra els noms de les aplicacions quan el cursor es troba sobre les icones del dock."

#: src/dialogs/dock_settings_dialog.cpp:1188
msgid "Include windows from every workspace in dock actions and cycling."
msgstr "Inclou finestres de tots els espais de treball en les accions del dock i el cicle de finestres."

