msgstr "בחר כיצד הסמלים מגיבים כאשר הסמן עובר מעליהם."

#: src/dialogs/dock_settings_dialog.cpp:1043
msgid "Select how running applications are marked on the dock."
msgstr "בחר כיצד מסומנים יישומים פועלים במגש."

#: src/dialogs/dock_settings_dialog.cpp:1050
msgid "Set the color of running-application indicators."
msgstr "קבע את צבע הסמנים של יישומים פועלים."

#: src/dialogs/dock_settings_dialog.cpp:1057
msgid "Use a GTK theme-derived gradient instead of a solid background."
msgstr "השתמש במדרגת צבע נובעת מנושא GTK במקום רקע אחיד."

#: src/dialogs/dock_settings_dialog.cpp:1064
msgid "Round the corners of the dock background."
msgstr "עגל את הפינות של רקע המגש."

#: src/dialogs/dock_settings_dialog.cpp:1071
msgid "Set the corner radius in pixels; -1 selects automatic sizing."
msgstr "קבע את רדיוס הפינה בפיקסלים; -1 בוחר גודל אוטומטי."

#: src/dialogs/dock_settings_dialog.cpp:1078
msgid "Show the DockLight home and launcher-management icon."
msgstr "הצג את סמל הבית וניהול משגר של DockLight."

#: src/dialogs/dock_settings_dialog.cpp:1085
msgid "Choose a custom image for the home icon, or use the built-in icon."
msgstr "בחר תמונה מותאמת אישית עבור סמל הבית, או השתמש בסמל המובנה."

#: src/dialogs/dock_settings_dialog.cpp:1094
msgid "Show application names when the pointer rests on dock icons."
msgstr "הצג שמות אפליקציות כאשר הסמן מוצב על אייקונים במגש."

#: src/dialogs/dock_settings_dialog.cpp:1101
msgid "Include windows from every workspace in dock actions and cycling."
msgstr "כלול חלונות מכל סביבה במעשיי המגש ובסיבוב."

#: src/dialogs/dock_settings_dialog.cpp:1108
msgid "Show window previews when the pointer rests on running apps."
msgstr "הצג תצוגות מקדימות של חלונות כאשר הסמן מוצב על אפליקציות פעילות."

#: src/dialogs/dock_settings_dialog.cpp:1115
msgid "Close the preview popup after activating one of its windows."
msgstr "סגור את חלון התצוגה המקדימה לאחר הפעלת אחד מהחלונות שלו."

#: src/dialogs/dock_settings_dialog.cpp:1122
msgid "Set the accent color used by window previews."
msgstr "הגדר את צבע ההדגשה המשמש בתצוגות חלונות."

#: src/dialogs/dock_settings_dialog.cpp:1129
msgid "Set preview height in pixels; 0 selects automatic sizing."
msgstr "הגדר גובה תצוגה מקדימה בפיקסלים; 0 בוחר גודל אוטומטי."

#: src/dialogs/dock_settings_dialog.cpp:1136
msgid "Set how long to wait before showing a preview."
msgstr "הגדר כמה זמן לחכות לפני הצגת תצוגה מקדימה."

#: src/dialogs/dock_settings_dialog.cpp:1144
msgid "Choose the display where DockLight appears."
msgstr "בחר את התצוגה בה מופיע DockLight."

#: src/dialogs/dock_settings_dialog.cpp:1151
msgid "Choose the screen edge where the dock is placed."
msgstr "בחר את קצה המסך שבו ממוקם המגש."

#: src/dialogs/dock_settings_dialog.cpp:1158
msgid "Align dock content along the selected screen edge."
msgstr "יישר את תוכן המגש לאורך קצה המסך הנבחר."

#: src/dialogs/dock_settings_dialog.cpp:1165
msgid "Choose when the dock moves out of view."
msgstr "בחר מתי המגש יוצא מהתצוגה."

#: src/dialogs/dock_settings_dialog.cpp:1172
msgid "Set how long to wait before hiding the dock."
msgstr "הגדר כמה זמן לחכות לפני הסתרת המגש."

#: src/dialogs/dock_settings_dialog.cpp:1182
