msgstr "Utilizar un degradat derivat d'un tèma GTK al luec d'un fons solid."

#: src/dialogs/dock_settings_dialog.cpp:1085
msgid "Round the corners of the dock background."
msgstr "Arrondir los cantons del fons del dock."

#: src/dialogs/dock_settings_dialog.cpp:1092
msgid "Set the corner radius in pixels; -1 selects automatic sizing."
msgstr ""
"Definir lo ròtle del canton en pixels; -1 selecciona la talha automàtica."

#: src/dialogs/dock_settings_dialog.cpp:1099
msgid "Show the DockLight home and launcher-management icon."
msgstr "Afichar l'icòna de la maison DockLight e de gestion del lançador."

#: src/dialogs/dock_settings_dialog.cpp:1106
msgid "Choose a custom image for the home icon, or use the built-in icon."
msgstr ""
"Escaissir una imatge personalizada per l'icòna de la maison, o utilizar "
"l'icòna integrat."

#: src/dialogs/dock_settings_dialog.cpp:1115
msgid "Show application names when the pointer rests on dock icons."
msgstr ""
"Montrar los noms d'aplicacions quand lo punter se pausa sus las icònas del "
"dock."

#: src/dialogs/dock_settings_dialog.cpp:1122
msgid "Include windows from every workspace in dock actions and cycling."
msgstr ""
"Incluir las fenèstras de cada espaci de trabalh dins las accions del dock e "
"lo cicle."

#: src/dialogs/dock_settings_dialog.cpp:1129
msgid "Show window previews when the pointer rests on running apps."
msgstr ""
"Montrar los aperçuts de fenèstra quand lo punter se pausa sus las "
"aplicacions en execucion."

#: src/dialogs/dock_settings_dialog.cpp:1136
msgid "Close the preview popup after activating one of its windows."
msgstr "Tampar lo popup d'aperçut après aver activat una de sas fenèstras."

#: src/dialogs/dock_settings_dialog.cpp:1143
msgid "Set the accent color used by window previews."
msgstr "Determinar la color d'accent utilizada pels aperçuts de fenèstra."

#: src/dialogs/dock_settings_dialog.cpp:1150
msgid "Set preview height in pixels; 0 selects automatic sizing."
msgstr ""
"Determinar l'atge de l'aperçut en pixels; 0 causís dimensionament automatic."

#: src/dialogs/dock_settings_dialog.cpp:1157
msgid "Set how long to wait before showing a preview."
msgstr "Determinar lo temps d'espera abans de mostrar un aperçut."

#: src/dialogs/dock_settings_dialog.cpp:1165
msgid "Choose the display where DockLight appears."
msgstr "Causir l'afichatge ont DockLight apparis."

#: src/dialogs/dock_settings_dialog.cpp:1172
msgid "Choose the screen edge where the dock is placed."
msgstr "Causir lo bord de l'ecran ont se plaça lo dock."

#: src/dialogs/dock_settings_dialog.cpp:1179
msgid "Align dock content along the selected screen edge."
msgstr "Alinear lo contegnut del dock al long del bord d'ecran seleccionat."

#: src/dialogs/dock_settings_dialog.cpp:1186
msgid "Choose when the dock moves out of view."
msgstr "Causir quand lo dock se desplaça fòra de vista."

#: src/dialogs/dock_settings_dialog.cpp:1193
msgid "Set how long to wait before hiding the dock."
msgstr "Determinar lo temps d'espera abans de mascar lo dock."

#: src/dialogs/dock_settings_dialog.cpp:1203
msgid "Choose an autohide animation supported by this desktop."
msgstr ""
"Causir una animacion d'automasquedatge suportada per aqueste escriptor."

