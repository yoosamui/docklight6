msgid "Set the dock icon size from 32 to 128 pixels."
msgstr "Imposta la dimensione dell'icona del dock da 32 a 128 pixel."

#: src/dialogs/dock_settings_dialog.cpp:1123
msgid "Choose how icons respond when the pointer moves over them."
msgstr "Scegli come le icone reagiscono quando il cursore le attraversa."

#: src/dialogs/dock_settings_dialog.cpp:1130
msgid "Select how running applications are marked on the dock."
msgstr "Seleziona come vengono segnalate le applicazioni in esecuzione sul dock."

#: src/dialogs/dock_settings_dialog.cpp:1137
msgid "Set the color of running-application indicators."
msgstr "Imposta il colore degli indicatori delle applicazioni in esecuzione."

#: src/dialogs/dock_settings_dialog.cpp:1144
msgid "Use a GTK theme-derived gradient instead of a solid background."
msgstr "Usa un gradiente derivato dal tema GTK invece di uno sfondo uniforme."

#: src/dialogs/dock_settings_dialog.cpp:1151
msgid "Round the corners of the dock background."
msgstr "Arrotonda gli angoli dello sfondo del dock."

#: src/dialogs/dock_settings_dialog.cpp:1158
msgid "Set the corner radius in pixels; -1 selects automatic sizing."
msgstr "Imposta il raggio dell'angolo in pixel; -1 seleziona la dimensione automatica."

#: src/dialogs/dock_settings_dialog.cpp:1165
msgid "Show the DockLight home and launcher-management icon."
msgstr "Mostra l'icona Home e di gestione del launcher di DockLight."

#: src/dialogs/dock_settings_dialog.cpp:1172
msgid "Choose a custom image for the home icon, or use the built-in icon."
msgstr "Scegli un'immagine personalizzata per l'icona Home, o usa l'icona incorporata."

#: src/dialogs/dock_settings_dialog.cpp:1181
msgid "Show application names when the pointer rests on dock icons."
msgstr "Mostra i nomi delle applicazioni quando il puntatore si ferma sulle icone del dock."

#: src/dialogs/dock_settings_dialog.cpp:1188
msgid "Include windows from every workspace in dock actions and cycling."
msgstr "Includi le finestre di ogni area di lavoro nelle azioni e nel ciclismo del dock."

#: src/dialogs/dock_settings_dialog.cpp:1195
msgid "Show window previews when the pointer rests on running apps."
msgstr "Mostra l'anteprima delle finestre quando il puntatore si ferma sulle applicazioni in esecuzione."

#: src/dialogs/dock_settings_dialog.cpp:1202
msgid "Close the preview popup after activating one of its windows."
msgstr "Chiudi il popup dell'anteprima dopo aver attivato una delle sue finestre."

#: src/dialogs/dock_settings_dialog.cpp:1209
msgid "Set the accent color used by window previews."
msgstr "Imposta il colore di accento utilizzato dalle anteprime delle finestre."

#: src/dialogs/dock_settings_dialog.cpp:1216
msgid "Set preview height in pixels; 0 selects automatic sizing."
msgstr "Imposta l'altezza dell'anteprima in pixel; 0 seleziona la dimensione automatica."

#: src/dialogs/dock_settings_dialog.cpp:1223
msgid "Set how long to wait before showing a preview."
msgstr "Imposta quanto tempo attendere prima di mostrare un'anteprima."

#: src/dialogs/dock_settings_dialog.cpp:1231
msgid "Choose the display where DockLight appears."
msgstr "Scegli lo schermo su cui appare DockLight."

#: src/dialogs/dock_settings_dialog.cpp:1238
msgid "Choose the screen edge where the dock is placed."
msgstr "Scegli il bordo dello schermo dove viene posizionato il dock."

#: src/dialogs/dock_settings_dialog.cpp:1245
msgid "Align dock content along the selected screen edge."
msgstr "Allinea il contenuto del dock lungo il bordo dello schermo selezionato."

#: src/dialogs/dock_settings_dialog.cpp:1252
msgid "Choose when the dock moves out of view."
msgstr "Scegli quando il dock si sposta fuori dalla visuale."

#: src/dialogs/dock_settings_dialog.cpp:1259
msgid "Set how long to wait before hiding the dock."
msgstr "Imposta quanto tempo attendere prima di nascondere il dock."

#: src/dialogs/dock_settings_dialog.cpp:1269
msgid "Choose an autohide animation supported by this desktop."
msgstr "Scegli un'animazione di autohide supportata da questo desktop."

