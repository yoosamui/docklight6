#pragma once

#pragma once

#include "dock_enums.h"
#include "dock_item.h"
#include "dock_geometry.h"
#include "dock_layout_geometry.h"
#include "dock_tooltip_window.h"
#include "dock_layout_engine.h"

class DockWindow : public Gtk::Window
{
public:
    DockWindow();

    DockLocation location() const;

    void show_tooltip(DockItem &item);
    void hide_tooltip();
    void schedule_show_tooltip(DockItem &item);

private:
    DockLayoutEngine m_layout_engine;

    DockLayoutGeometry m_layout_geometry;

    Gtk::Overlay m_overlay;

    DockTooltipWindow m_overlay_window;

    Gtk::Box m_dock_box{Gtk::ORIENTATION_HORIZONTAL};

    DockLocation m_location = DockLocation::bottom;

    DockLayout m_layout;

    DockSize m_docksize;

    sigc::connection m_hide_connection;
    sigc::connection m_show_timer;
    sigc::connection m_hide_timer;

    DockItem *m_pending_item = nullptr;

    GtkWindow *win();

    void start_hide_timer();
    void cancel_hide_timer();

    void create_dock();

    void update_alignment();
    void update_layout();

    void apply_location();
    void apply_alignment();

    void schedule_hide_overlay();

    int preferred_dock_width() const;
    int preferred_dock_height() const;
    int dock_left() const;
};
