
#include "dock_window.h"
#include "dock_constants.h"
#include "dock_geometry.h"
#include "dock_common.h"

#include "launcher_manager.h"
#include <gtk-layer-shell.h>

#include <iostream>
#include <memory>

DockWindow::DockWindow()
{

    set_decorated(false);
    set_resizable(false);

    GtkWindow *gtk_win = win();

    gtk_layer_init_for_window(gtk_win);

    gtk_layer_set_namespace(
        gtk_win,
        "docklight6");

    gtk_layer_set_layer(
        gtk_win,
        GTK_LAYER_SHELL_LAYER_TOP);

    gtk_layer_auto_exclusive_zone_enable(
        gtk_win);

    gtk_layer_set_anchor(
        gtk_win,
        GTK_LAYER_SHELL_EDGE_BOTTOM,
        TRUE);

    gtk_layer_set_margin(
        gtk_win,
        GTK_LAYER_SHELL_EDGE_BOTTOM,
        0);

    create_dock();

    LauncherManager manager;
    auto apps = manager.load_applications();

    int count = 0;

    for (const auto &launcher : apps)
    {
        if (count >= DockConstants::MAX_DOCK_ITEMS)
            break;

        auto item = Gtk::manage(
            new DockItem(*this, launcher.app));

        m_dock_box.pack_start(
            *item,
            Gtk::PACK_SHRINK);

        ++count;
    }
    m_geometry.set_item_count(count);

    m_overlay.add(m_dock_box);
    m_dock_box.show_all();

    update_layout();

    m_overlay_window.set_halign(Gtk::ALIGN_FILL);
    m_overlay_window.set_valign(Gtk::ALIGN_FILL);

    add(m_overlay);

    show_all_children();

    /*   signal_focus_out_event().connect(
          [this](GdkEventFocus *)
          {
              std::cout
                  << "DOCK FOCUS LOST"
                  << std::endl;

              cancel_hide_timer();

              m_overlay_window.hide_overlay();

              return false;
          }); */

    // Layer-shell tooltip window exists,
    // but must start hidden.
    m_overlay_window.hide_overlay();
}

void DockWindow::schedule_show_tooltip(DockItem &item)
{
    if (m_show_timer.connected())
        m_show_timer.disconnect();

    m_pending_item = &item;

    m_show_timer =
        Glib::signal_timeout().connect(
            [this]()
            {
                if (!m_pending_item)
                    return false;

                show_tooltip(
                    *m_pending_item);

                m_pending_item = nullptr;

                return false;
            },
            DockConstants::TOOLTIP_SHOW_DELAY_MS);
}

void DockWindow::schedule_hide_overlay()
{
    // if (m_hide_connection.connected())
    //     m_hide_connection.disconnect();

    // m_hide_connection =
    //     Glib::signal_timeout().connect(
